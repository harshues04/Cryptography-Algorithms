{"ast":null,"code":"const atbashCipher={name:'Atbash',keyRequired:false,func:(text,_operation)=>{return text.toUpperCase().replace(/[A-Z]/g,char=>{const code=char.charCodeAt(0)-65;const mirrored=25-code;return String.fromCharCode(mirrored+65);});}};export default atbashCipher;","map":{"version":3,"names":["atbashCipher","name","keyRequired","func","text","_operation","toUpperCase","replace","char","code","charCodeAt","mirrored","String","fromCharCode"],"sources":["E:/College/College notes/Semester-6 notes/Cryptography Techniques/Algorithms Implementation/crypto-alg/src/algorithms/atbash.ts"],"sourcesContent":["import { Algorithm, Operation } from '../types';\r\n\r\nconst atbashCipher: Algorithm = {\r\n  name: 'Atbash',\r\n  keyRequired: false,\r\n  func: (text: string, _operation: Operation) => {\r\n    return text\r\n      .toUpperCase()\r\n      .replace(/[A-Z]/g, (char) => {\r\n        const code = char.charCodeAt(0) - 65;\r\n        const mirrored = 25 - code;\r\n        return String.fromCharCode(mirrored + 65);\r\n      });\r\n  },\r\n};\r\n\r\nexport default atbashCipher;"],"mappings":"AAEA,KAAM,CAAAA,YAAuB,CAAG,CAC9BC,IAAI,CAAE,QAAQ,CACdC,WAAW,CAAE,KAAK,CAClBC,IAAI,CAAEA,CAACC,IAAY,CAAEC,UAAqB,GAAK,CAC7C,MAAO,CAAAD,IAAI,CACRE,WAAW,CAAC,CAAC,CACbC,OAAO,CAAC,QAAQ,CAAGC,IAAI,EAAK,CAC3B,KAAM,CAAAC,IAAI,CAAGD,IAAI,CAACE,UAAU,CAAC,CAAC,CAAC,CAAG,EAAE,CACpC,KAAM,CAAAC,QAAQ,CAAG,EAAE,CAAGF,IAAI,CAC1B,MAAO,CAAAG,MAAM,CAACC,YAAY,CAACF,QAAQ,CAAG,EAAE,CAAC,CAC3C,CAAC,CAAC,CACN,CACF,CAAC,CAED,cAAe,CAAAX,YAAY","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}